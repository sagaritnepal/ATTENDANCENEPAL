SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key only — this worker runs on trusted on-prem hardware, never ships to the app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The companies.id this bridge's devices/employees belong to — one physical
# bridge deployment = one company's LAN = one company_id. Find it via
# `select id from companies where name = 'Your Company Name';` in the SQL editor.
COMPANY_ID=your-company-uuid
SYNC_INTERVAL_MS=15000
