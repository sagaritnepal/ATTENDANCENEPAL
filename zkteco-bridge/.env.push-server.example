# Config for push-server.js — ONE instance of this serves every company,
# unlike index.js/.env.example which is one instance per company. There is
# deliberately no COMPANY_ID here: this server resolves which company a
# push belongs to per-request, from the device's serial number against the
# `devices` table.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key only — this runs on a trusted central server, never ships to the app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Port the server listens on. Point every company's device Cloud Server/ADMS
# setting at this host:port.
PUSH_PORT=8088

# How often the device-serial and employee-fingerprint caches are refreshed
# from Supabase (ms) — controls how quickly a newly-registered device or
# newly-synced employee is picked up without restarting the process.
REFRESH_INTERVAL_MS=60000

# A device that hasn't pushed anything in this long (ms) gets marked
# offline — there's no active poll here to fail the way index.js has, so
# staleness is the only signal.
OFFLINE_AFTER_MS=300000
