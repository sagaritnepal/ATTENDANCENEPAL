NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (no NEXT_PUBLIC_ prefix, so Vercel never exposes it to the browser).
# Required by app/api/**/route.ts for admin operations (create-login, reset-password,
# update-login-email) — bypasses Row Level Security, so keep it out of client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
